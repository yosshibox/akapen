<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!--
      Boundary-value test project for SettingsStore.cs (spec §4.7 / §9 M2-E),
      added in response to Codex 再レビュー Medium 2: the manual /tmp
      boundary-test harness used while writing SettingsStore.cs was cleaned up
      after the session and never made it into the repo, so none of it could
      be re-run in CI or by the next contributor. This project fixes that by
      living in the repo and running in CI.

      Plain net8.0 console app, NOT net8.0-windows10.0.19041.0 like the shell
      (AkapenApp.csproj) — SettingsStore.cs itself has zero WinUI/Windows App
      SDK dependency (see its own header comment: only System.IO /
      System.Text.Json), so it builds and runs on any OS `dotnet` supports.
      That is exactly why this project can run on ubuntu-latest in CI instead
      of needing a windows-latest runner or the WindowsAppSDK toolchain.
    -->
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <RootNamespace>AkapenApp.Tests</RootNamespace>
    <AssemblyName>AkapenApp.Tests</AssemblyName>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <IsPackable>false</IsPackable>

    <!--
      Roll forward to whatever major .NET runtime is actually installed. Dev
      machines / CI runners here carry a range of SDKs (this repo has been
      built with everything from the .NET 8 SDK CI pins to newer major
      versions locally); SettingsStore.cs has no net8.0-specific API surface,
      so running it under a later major runtime is safe and avoids forcing a
      redundant net8.0 runtime install just for this test console.
    -->
    <RollForward>LatestMajor</RollForward>
  </PropertyGroup>

  <ItemGroup>
    <!--
      Link (not copy) the real SettingsStore.cs from the shell project. A
      copy would drift from the source of truth the moment either side is
      edited without the other; Link keeps this a single source file compiled
      into two different assemblies (the WinUI shell and this test console).
      SettingsStore / AkapenSettings / AkapenOutputDirMode are all `internal`,
      which is fine here — this project compiles the file directly into its
      own assembly rather than referencing AkapenApp.csproj, so no
      InternalsVisibleTo is needed (same reasoning as Akapen.SmokeTest's
      relationship to Akapen.Native, just via Link instead of ProjectReference
      since AkapenApp.csproj cannot be evaluated on non-Windows OSes at all).
    -->
    <Compile Include="..\AkapenApp\SettingsStore.cs" Link="SettingsStore.cs" />
  </ItemGroup>

</Project>
