<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <AssemblyName>Akapen</AssemblyName>
    <Product>Akapen</Product>
    <ApplicationTitle>Akapen</ApplicationTitle>
    <Version>1.0.1</Version>
    <AssemblyVersion>1.0.1.0</AssemblyVersion>
    <FileVersion>1.0.1.0</FileVersion>
    <ApplicationIcon>..\..\..\assets\app-icon\akapen.ico</ApplicationIcon>
    <TargetFramework>net8.0</TargetFramework>
    <RuntimeIdentifiers>win-x64</RuntimeIdentifiers>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- Windows MVP: raw user32.dll P/Invoke + the stable Rust C ABI. No
         WinForms/WPF/WinUI or Windows App SDK runtime is required. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Include="..\..\..\assets\icons\akapen-ui-icons.svg" Link="Assets\akapen-ui-icons.svg" />
  </ItemGroup>

</Project>
