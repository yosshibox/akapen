<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <AssemblyName>Akapen</AssemblyName>
    <Product>Akapen</Product>
    <ApplicationTitle>Akapen</ApplicationTitle>
    <Version>1.2.0</Version>
    <AssemblyVersion>1.2.0.0</AssemblyVersion>
    <FileVersion>1.2.0.0</FileVersion>
    <ApplicationIcon>..\..\..\assets\app-icon\akapen.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <TargetFramework>net8.0</TargetFramework>
    <RuntimeIdentifiers>win-x64;win-arm64</RuntimeIdentifiers>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- Windows MVP: raw user32.dll P/Invoke + the stable Rust C ABI. No
         WinForms/WPF/WinUI or Windows App SDK runtime is required. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Include="..\..\..\assets\icons\akapen-ui-icons.svg" Link="Assets\akapen-ui-icons.svg" />
    <!-- V1.2.0: the 朱の一筆 pixel logo shown above the "Akapen" title on the
         empty startup screen, matching the Mac shell. -->
    <EmbeddedResource Include="..\..\..\assets\app-icon\akapen-pixel-source.png" Link="Assets\akapen-pixel-source.png" />
    <!-- V1.1.2: the HTML manual ships beside the exe so ヘルプ → Akapen ヘルプ
         can open it offline. -->
    <Content Include="..\..\..\docs\manual\akapen-manual-windows-ja.html" Link="manual\akapen-manual-ja.html" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
