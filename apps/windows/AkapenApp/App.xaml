<?xml version="1.0" encoding="utf-8"?>
<!--
  Akapen WinUI 3 shell entry point (spec §7.4-4 / §9 M2). The Application
  element only pulls in the default XAML controls resources; every functional
  choice — window bring-up, GPU surface attach, input routing — lives in
  App.xaml.cs and MainWindow.xaml(.cs).
-->
<Application
    x:Class="AkapenApp.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>
</Application>
